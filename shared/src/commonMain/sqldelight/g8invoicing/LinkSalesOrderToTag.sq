CREATE TABLE LinkSalesOrderToTag (
    id INTEGER PRIMARY KEY NOT NULL,
    sales_order_id INTEGER NOT NULL,
    tag_id INTEGER NOT NULL,
    updated_by_user_at TEXT,

  FOREIGN KEY(tag_id)
         REFERENCES SalesOrderTag(sales_order_tag_id)
         ON DELETE CASCADE
);

saveSalesOrderTag:
INSERT OR REPLACE
INTO LinkSalesOrderToTag (id, sales_order_id, tag_id, updated_by_user_at)
VALUES (?, ?, ?, NULL );

updateSalesOrderTag:
UPDATE LinkSalesOrderToTag
SET sales_order_id = :sales_order_id,
    tag_id = :tag_id,
    updated_by_user_at = (datetime('now', 'localtime'))
WHERE
    sales_order_id = :sales_order_id;

getSalesOrderTag:
SELECT *
FROM LinkSalesOrderToTag
WHERE sales_order_id = :sales_order_id;

delete:
DELETE FROM LinkSalesOrderToTag
WHERE sales_order_id = :id;
