CREATE TABLE ClientOrIssuerAddress (
  id INTEGER PRIMARY KEY NOT NULL,
  address_title TEXT,
  address_line_1 TEXT,
  address_line_2 TEXT,
  zip_code TEXT,
  city TEXT,
  country_code TEXT
);

get:
SELECT *
FROM ClientOrIssuerAddress
WHERE id = :id;

save:
INSERT INTO ClientOrIssuerAddress (id, address_title, address_line_1, address_line_2, zip_code, city, country_code)
VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE ClientOrIssuerAddress
SET address_title = :address_title,
    address_line_1 = :address_line_1,
    address_line_2 = :address_line_2,
    zip_code = :zip_code,
    city = :city,
    country_code = :country_code
WHERE
    id = :id;

getLastCountryCode:
SELECT country_code
FROM ClientOrIssuerAddress
WHERE country_code IS NOT NULL AND country_code != ''
ORDER BY id DESC
LIMIT 1;

-- Distinct country codes ordered by most-recently-used (MAX(id) per code).
-- GROUP BY collapses duplicates; MAX(id) drives the sort so the most recent
-- occurrence of each code wins.
getRecentCountryCodes:
SELECT country_code
FROM ClientOrIssuerAddress
WHERE country_code IS NOT NULL AND country_code != ''
GROUP BY country_code
ORDER BY MAX(id) DESC
LIMIT :limit;

delete:
DELETE FROM ClientOrIssuerAddress
WHERE id = :id;

getLastInsertedRowId:
SELECT id
FROM ClientOrIssuerAddress
ORDER BY id DESC
LIMIT 1;