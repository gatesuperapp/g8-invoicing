CREATE TABLE DocumentClientOrIssuer (
  id INTEGER PRIMARY KEY NOT NULL,
  type TEXT,
  original_client_id INTEGER,
  original_version INTEGER DEFAULT 1,
  first_name TEXT,
  name TEXT NOT NULL,
  phone TEXT,
  email TEXT,
  notes TEXT,
  company_id1_label TEXT,
  company_id1_number TEXT,
  company_id2_label TEXT,
  company_id2_number TEXT,
  company_id3_label TEXT,
  company_id3_number TEXT,
  logo_path TEXT,
  vat_exempt INTEGER DEFAULT 0,
  intra_eu_sales INTEGER DEFAULT 0,
  payment_iban TEXT,
  payment_bic TEXT,
  -- Country of the frozen bank (ISO 3166-1 alpha-2). Drives the rendered
  -- label on preview + PDF ("IBAN :" vs "N° de compte :").
  payment_country TEXT,

  created_at REAL DEFAULT (datetime('now', 'localtime')),
  updated_at REAL DEFAULT (datetime('now', 'localtime')),
  deleted_at REAL DEFAULT (datetime('now', 'localtime')),

  FOREIGN KEY(original_client_id)
      REFERENCES ClientOrIssuer(id)
      ON DELETE SET NULL
);

get:
SELECT *
FROM DocumentClientOrIssuer
WHERE id = :id;

getIdByMail:
SELECT id
FROM DocumentClientOrIssuer
WHERE email = :email;

getIdByName:
SELECT id
FROM DocumentClientOrIssuer
WHERE name = :name AND first_name =: first_name;

save:
INSERT INTO DocumentClientOrIssuer (id, type, original_client_id, original_version, first_name, name, phone, email, notes, company_id1_label, company_id1_number, company_id2_label, company_id2_number, company_id3_label, company_id3_number, logo_path, vat_exempt, intra_eu_sales, payment_iban, payment_bic, payment_country)
VALUES (:id, :type, :original_client_id, :original_version, :first_name, :name, :phone, :email, :notes, :company_id1_label, :company_id1_number, :company_id2_label, :company_id2_number, :company_id3_label, :company_id3_number, :logo_path, :vat_exempt, :intra_eu_sales, :payment_iban, :payment_bic, :payment_country);

update:
UPDATE DocumentClientOrIssuer
SET type = :type,
    original_client_id = :original_client_id,
    original_version = :original_version,
    first_name = :first_name,
    name = :name,
    phone = :phone,
    email = :email,
    notes = :notes,
    company_id1_label = :company_id1_label,
    company_id1_number = :company_id1_number,
    company_id2_label = :company_id2_label,
    company_id2_number = :company_id2_number,
    company_id3_label = :company_id3_label,
    company_id3_number = :company_id3_number,
    logo_path = :logo_path,
    vat_exempt = :vat_exempt,
    intra_eu_sales = :intra_eu_sales,
    payment_iban = :payment_iban,
    payment_bic = :payment_bic,
    payment_country = :payment_country
WHERE
    id = :id;

delete:
DELETE FROM DocumentClientOrIssuer
WHERE id = :id;

getLastInsertedClientOrIssuerId:
SELECT id
FROM DocumentClientOrIssuer
ORDER BY id DESC
LIMIT 1;

getLastInsertedIssuer:
SELECT *
FROM DocumentClientOrIssuer
WHERE type = 'issuer'
ORDER BY id DESC
LIMIT 1;

getLastInsertedRowId:
SELECT id
FROM DocumentClientOrIssuer
ORDER BY id DESC
LIMIT 1;

updateOriginalVersion:
UPDATE DocumentClientOrIssuer
SET original_version = :original_version
WHERE id = :id;

-- Dedicated write for the payment-means picker on invoices — the user swaps
-- the frozen bank without touching any other issuer field.
updatePaymentBank:
UPDATE DocumentClientOrIssuer
SET payment_iban = :payment_iban,
    payment_bic = :payment_bic,
    payment_country = :payment_country
WHERE id = :id;

getLast3RecentOriginalIdsByType:
SELECT original_client_id
FROM DocumentClientOrIssuer
WHERE original_client_id IS NOT NULL
  AND type = :type
GROUP BY original_client_id
ORDER BY MAX(id) DESC
LIMIT 3;

