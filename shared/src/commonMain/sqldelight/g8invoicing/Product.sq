CREATE TABLE Product (
  id INTEGER PRIMARY KEY NOT NULL,
  name TEXT NOT NULL,
  description TEXT,
  unit TEXT,
  unit_code TEXT,
  type TEXT,
  product_tax_id INTEGER,
  -- Self-FK vers ClientOrIssuer.id filtré type='issuer'. Le produit est
  -- rattaché à l'entreprise depuis laquelle il a été créé. Backfill par la
  -- migration 6 sur l'issuer implicite le plus récent.
  company_id INTEGER,
  -- 2.1 catégorie produit (module premium "product_categories"). Nullable
  -- parce que la fonctionnalité peut rester désactivée + aucune catégorie
  -- par défaut. SET NULL on parent delete pour que supprimer une catégorie
  -- ne détruise pas les produits qui la portent.
  product_category_id INTEGER,

  created_at REAL DEFAULT (datetime('now', 'localtime')),
  updated_at REAL DEFAULT (datetime('now', 'localtime')),

    FOREIGN KEY(product_tax_id)
          REFERENCES TaxRate(product_tax_id)
          ON DELETE CASCADE,
    FOREIGN KEY(product_category_id)
          REFERENCES ProductCategory(product_category_id)
          ON DELETE SET NULL
);

getProduct:
SELECT *
FROM Product
WHERE id = :id;

getAllProducts:
SELECT *
FROM Product;

saveProduct:
INSERT INTO Product (id, name, description, product_tax_id, unit, unit_code, type, company_id, product_category_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateProduct:
UPDATE Product
SET name = :name,
    description = :description,
    product_tax_id = :product_tax_id,
    unit = :unit,
    unit_code = :unit_code,
    type = :type,
    product_category_id = :product_category_id
WHERE
    id = :id;

-- Bulk-assign a category to the given products (nullable → clears the
-- category). Used by the product-list bottom bar's "Marquer" action.
updateProductCategoryId:
UPDATE Product
SET product_category_id = :product_category_id,
    updated_at = datetime('now', 'localtime')
WHERE id = :id;

deleteProduct:
DELETE FROM Product
WHERE id = :id;

-- 1.9 migration wizard: bulk-move a product under a specific
-- issuer/company. Mirrors ClientOrIssuer.updateCompanyId.
updateProductCompanyId:
UPDATE Product
SET company_id = :company_id
WHERE id = :id;

clearTaxRateFromProducts:
UPDATE Product
SET product_tax_id = NULL
WHERE product_tax_id = :taxId;

checkIfEmpty:
SELECT count(*) FROM ClientOrIssuer LIMIT 1;

lastInsertRowId:
SELECT id
FROM Product
ORDER BY id DESC
LIMIT 1;

countAll:
SELECT COUNT(*) FROM Product;

getLast5DistinctUnitCodes:
SELECT unit_code
FROM Product
WHERE unit_code IS NOT NULL
GROUP BY unit_code
ORDER BY MAX(id) DESC
LIMIT 5;

getLastUsedProductType:
SELECT type
FROM Product
WHERE type IS NOT NULL
ORDER BY id DESC
LIMIT 1;

updateAllTypes:
UPDATE Product
SET type = :new_type,
    updated_at = datetime('now', 'localtime');

-- Multi-entreprise (étape 2). Produits rattachés à une entreprise donnée.
-- Utilisé par la liste Produits une fois filtrée par current_company_id.
getAllProductsForCompany:
SELECT *
FROM Product
WHERE company_id = :company_id;

-- Pré-check de suppression d'entreprise : compte les produits rattachés.
countProductsForCompany:
SELECT COUNT(*) FROM Product WHERE company_id = :company_id;
