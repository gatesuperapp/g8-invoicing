-- Migration 8 → 9 (release 2.1) — product categories (premium module
-- "product_categories"). Users define their own category list from the
-- management screen, assign one category per product either from the
-- product form (new "Catégorie" row below the main block, when the module
-- is active) or in bulk from the product list bottom bar ("Marquer").
--
-- No pre-seeded rows — the first category is always user-added. The chip
-- rendered under the product name uses a per-category colour picked from a
-- 10-swatch pastel palette.

CREATE TABLE ProductCategory (
  product_category_id INTEGER PRIMARY KEY NOT NULL,
  name TEXT NOT NULL,
  -- ARGB packed int. 0 means "pick the default pastel blue at render
  -- time" — avoids pinning a specific hex in the schema if the palette
  -- shifts later.
  color INTEGER NOT NULL DEFAULT 0,
  sort_order INTEGER NOT NULL DEFAULT 0,
  -- Scoped to the entreprise courante — same pattern as Product.company_id.
  -- Multi-entreprise users keep a separate category list per company; no FK
  -- declared because Company lives on the DataStore side (same way Product
  -- stores a plain integer rather than a cross-table FK).
  company_id INTEGER,
  created_at TEXT DEFAULT (datetime('now', 'localtime')),
  updated_at TEXT DEFAULT (datetime('now', 'localtime'))
);

ALTER TABLE Product ADD COLUMN product_category_id INTEGER REFERENCES ProductCategory(product_category_id) ON DELETE SET NULL;
