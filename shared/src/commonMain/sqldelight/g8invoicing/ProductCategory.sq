CREATE TABLE ProductCategory (
  product_category_id INTEGER PRIMARY KEY NOT NULL,
  name TEXT NOT NULL,
  -- ARGB packed int. 0 means "pick the default pastel blue at render
  -- time" — avoids pinning a specific hex in the schema if the palette
  -- shifts later.
  color INTEGER NOT NULL DEFAULT 0,
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at TEXT DEFAULT (datetime('now', 'localtime')),
  updated_at TEXT DEFAULT (datetime('now', 'localtime'))
);

getCategory:
SELECT *
FROM ProductCategory
WHERE product_category_id = :id;

getAllCategories:
SELECT *
FROM ProductCategory
ORDER BY sort_order ASC, product_category_id ASC;

saveCategory:
INSERT
INTO ProductCategory (name, color, sort_order)
VALUES (:name, :color, :sort_order);

updateCategory:
UPDATE ProductCategory
SET name = :name,
    color = :color,
    updated_at = datetime('now', 'localtime')
WHERE product_category_id = :id;

deleteCategory:
DELETE FROM ProductCategory
WHERE product_category_id = :id;

lastInsertRowId:
SELECT product_category_id
FROM ProductCategory
ORDER BY product_category_id DESC
LIMIT 1;
