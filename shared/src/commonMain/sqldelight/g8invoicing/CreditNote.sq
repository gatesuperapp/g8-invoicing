CREATE TABLE CreditNote (
  credit_note_id INTEGER PRIMARY KEY NOT NULL,
  number TEXT,
  issuing_date TEXT,
  reference TEXT,
  free_field TEXT,
  currency TEXT,
  due_date TEXT,
  footer TEXT,
  watermark_text TEXT,
  labels_snapshot TEXT,
  show_currency_and_auto_tax_column INTEGER NOT NULL DEFAULT 0,
  format_locale TEXT,
  -- See Invoice.payment_means_selections.
  payment_means_selections TEXT,
  -- See Invoice.payment_means_label.
  payment_means_label TEXT,
  -- See Invoice.payment_means_hidden.
  payment_means_hidden INTEGER NOT NULL DEFAULT 0,
  -- See Invoice.payment_bank_hidden.
  payment_bank_hidden INTEGER NOT NULL DEFAULT 0,
  -- See Invoice.payment_means_other_checked.
  payment_means_other_checked INTEGER NOT NULL DEFAULT 0,
  -- See Invoice.payment_bank_label.
  payment_bank_label TEXT,
  -- Entreprise (issuer maître) émettrice, figée à la création. Sert la
  -- numérotation par entreprise + le filtrage de la liste des avoirs par
  -- entreprise courante.
  original_company_id INTEGER,

  created_at TEXT DEFAULT (datetime('now', 'localtime')),
  updated_at TEXT DEFAULT (datetime('now', 'localtime')),
  deleted_at TEXT DEFAULT (datetime('now', 'localtime')));

get:
SELECT *
FROM CreditNote
WHERE credit_note_id = :id;

getId:
SELECT credit_note_id
FROM CreditNote
WHERE credit_note_id = :id;

getLastCreditNoteNumber:
SELECT number
FROM CreditNote
ORDER BY credit_note_id DESC
LIMIT 1;

-- Multi-entreprise (étape 2). Numérotation des avoirs indépendante par
-- entreprise émettrice.
getLastCreditNoteNumberForCompany:
SELECT number
FROM CreditNote
WHERE original_company_id = :company_id
ORDER BY credit_note_id DESC
LIMIT 1;

getAll:
SELECT *
FROM CreditNote;

-- Multi-entreprise (étape 2). Filtre par entreprise courante — même
-- pattern que Invoice.getAllForCompany.
getAllForCompany:
SELECT *
FROM CreditNote
WHERE original_company_id = :company_id;

getAllIds:
SELECT credit_note_id
FROM CreditNote;

save:
INSERT INTO CreditNote (credit_note_id, number, issuing_date, reference, free_field, currency, due_date, footer, watermark_text, labels_snapshot, show_currency_and_auto_tax_column, format_locale, payment_means_selections, payment_means_label, payment_means_hidden, payment_bank_hidden, payment_means_other_checked, payment_bank_label, original_company_id)
VALUES (?,  ?,  ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE CreditNote
SET number = :number,
    issuing_date = :issuing_date,
    reference = :reference,
    free_field = :free_field,
    currency =: currency,
    due_date =: due_date,
    footer  =: footer,
    payment_means_selections = :payment_means_selections,
    payment_means_label = :payment_means_label,
    payment_means_hidden = :payment_means_hidden,
    payment_bank_hidden = :payment_bank_hidden,
    payment_means_other_checked = :payment_means_other_checked,
    payment_bank_label = :payment_bank_label,
    updated_at =: updated_at

WHERE
    credit_note_id = :credit_note_id;

delete:
DELETE FROM CreditNote
WHERE credit_note_id = :id;

getLastInsertedRowId:
SELECT credit_note_id
FROM CreditNote
ORDER BY credit_note_id DESC
LIMIT 1;

getLastInsertedFooter:
SELECT footer
FROM CreditNote
ORDER BY credit_note_id DESC
LIMIT 1;

-- Per-issuer payment reuse for a fresh credit note: pick the most recently
-- created document (credit note OR invoice) attached to the same master
-- issuer and read its payment means/bank labels + chip selections. Falls back
-- to invoices because credit notes are rare — if the user just created a
-- normal invoice for this company, that's what they want to inherit from.
getLastCreditNotePaymentReuseForIssuer:
SELECT payment_means_selections, payment_means_label,
       payment_means_other_checked, payment_bank_label
FROM (
    SELECT c.payment_means_selections, c.payment_means_label,
           c.payment_means_other_checked, c.payment_bank_label,
           c.created_at AS ts
    FROM CreditNote c
    JOIN LinkCreditNoteToDocumentClientOrIssuer l ON l.credit_note_id = c.credit_note_id
    JOIN DocumentClientOrIssuer dci ON dci.id = l.document_client_or_issuer_id
    WHERE dci.type = 'issuer' AND dci.original_client_id = :master_issuer_id
    UNION ALL
    SELECT i.payment_means_selections, i.payment_means_label,
           i.payment_means_other_checked, i.payment_bank_label,
           i.created_at AS ts
    FROM Invoice i
    JOIN LinkInvoiceToDocumentClientOrIssuer l ON l.invoice_id = i.invoice_id
    JOIN DocumentClientOrIssuer dci ON dci.id = l.document_client_or_issuer_id
    WHERE dci.type = 'issuer' AND dci.original_client_id = :master_issuer_id
)
ORDER BY ts DESC
LIMIT 1;

